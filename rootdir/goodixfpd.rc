# Goodix GF516M fingerprint daemon, installed to /system/etc/init.
# Matches the stock service definition (class main, user/group system).
service goodixfpd /system/bin/goodixfingerprintd
    class main
    user system
    group system
    seclabel u:r:fingerprintd:s0

# vendor.fps_hal starts before class main and calls openHal() only once; restart
# it after the daemon is up so the HAL connects to it.
on property:init.svc.goodixfpd=running
    restart vendor.fps_hal
