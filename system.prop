#
# system.prop for m681
#

ro.forge.meizu.expect_codename=m681

# Display
ro.sf.lcd_density=480

# RIL
# The argument string contains a space, so it cannot go through
# PRODUCT_PROPERTY_OVERRIDES.
rild.libargs=-d /dev/ttyC0

# The panel is upright at hwrotation=0 with the display shims in place.
ro.sf.hwrotation=0

# Navigation bar: the M3 Note has no hardware navigation keys.
qemu.hw.mainkeys=0

# ro.treble.enabled is set by the build from PRODUCT_FULL_TREBLE.
